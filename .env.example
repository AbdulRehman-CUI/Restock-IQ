# Relative paths resolve from this repository, never the shell's current directory.
RESTOCKIQ_DATA_DIR=data
RESTOCKIQ_RUNTIME_DIR=runtime
RESTOCKIQ_ARTIFACT_DIR=artifacts
RESTOCKIQ_MAX_UPLOAD_BYTES=12582912
RESTOCKIQ_FX_STALE_DAYS=3
RESTOCKIQ_QUOTE_STALE_DAYS=30
# ExchangeRate-API Standard. Leave the key blank for demo mode.
EXCHANGE_RATE_API_PROVIDER=exchange-rate-api
EXCHANGE_RATE_API_KEY=
# Optional HTTPS base including /v6, without a key or /latest/USD.
# EXCHANGE_RATE_API_BASE_URL=https://v6.exchangerate-api.com/v6
# Streamlit uses this HTTP API; the CLI --api-url flag takes precedence.
RESTOCKIQ_API_URL=http://127.0.0.1:8000
